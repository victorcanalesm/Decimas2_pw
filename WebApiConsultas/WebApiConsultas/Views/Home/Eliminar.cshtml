@{
    ViewData["Title"] = "Eliminar";
}
<style>
    .borde {
        border: solid 1px black;
        text-align: center;
        background-color: red;
        color: white;
    }

</style>
<script>
    $(document).ready(function(){
        cargaTabla();
    });
    function cargaTabla(){
        $.ajax({
            url: "../Home/cargaProductos",
            method: "GET",
            success: function(response){
                console.log(response);
                var tabla = "";
                $.each(response, function(key, value){
                    tabla += "<tr>";//tabla = tabla + "<tr>";
                    tabla += "<td>"+value.codProducto+"</td>";
                    tabla += "<td>"+value.nomProducto+"</td>";
                    tabla += "<td>"+value.precioProducto+"</td>";
                    tabla += "</tr>";
                });
                $("#datosTabla").html(tabla);
            }
        });
    }
</script>
<h1>@ViewData["Title"]</h1>
<br />
<form asp-action="EliminarDatos" method="post">
    <label>Código Producto</label>
    <input type="number" id="txtCodigo" name="txtCodigo" required />
    <br />
    <input type="submit" value="Eliminar" class="btn btn-primary" />
</form>
<br />
<h1>@ViewBag.mensaje</h1>
<br />
<div class="container">
    <div class="row">
        <div class="col-12">
            <table style="width:100%">
                <thead>
                    <tr>
                        <th class="borde">Código</th>
                        <th class="borde">Nombre Producto</th>
                        <th class="borde">Precio</th>
                    </tr>
                </thead>
                <tbody id="datosTabla"></tbody>
            </table>
        </div>
    </div>
</div>
